# deploy/terraform/aws/terraform.tfvars.example
#
# Copy to a named tfvars file for your environment:
#   cp terraform.tfvars.example staging.tfvars    # edit for staging
#   cp terraform.tfvars.example production.tfvars  # edit for production
#
# Usage with Terraform workspaces:
#   terraform workspace new staging      # first time only
#   terraform apply -var-file=staging.tfvars
#
#   terraform workspace new production   # first time only
#   terraform apply -var-file=production.tfvars

# --- Environment ---
# Controls namespace (traceroot-{environment}) and database name (traceroot_{environment})
environment = "staging"

# Docker image tag — always use a git SHA for staging/production (e.g. "sha-abc1234").
# Never use "latest": the daily CI build overwrites it and a pod restart would
# silently pick up unintended code.
# image_tag = "sha-abc1234"

# Name prefix for all AWS resources — must be unique per environment in the same account.
# Examples: "traceroot-staging", "traceroot-prod"
name = "traceroot-staging"
aws_region = "us-east-1"

# VPC
vpc_cidr = "10.0.0.0/16"

# EKS
kubernetes_version = "1.32"

# ECR (tagged builds kept per repository)
ecr_image_retention_count = 5

# RDS Aurora Serverless v2
postgres_min_capacity = 0.5
postgres_max_capacity = 2.0

# ElastiCache
cache_node_type = "cache.t4g.micro"

# S3 lifecycle
# Days before staged and failed ingest batches expire
# ingest_batch_expiration_days              = 7
# ingest_failed_expiration_days             = 30
# Days to keep every noncurrent version under events/ingest/ or events/failed/ before it is
# removed, whether its object expired, was deleted or was overwritten
# ingest_noncurrent_version_expiration_days = 1

# Custom domain (leave empty to use ALB URL)
# Staging example:  domain = "staging.traceroot.ai"
# Production example: domain = "app.traceroot.ai"
# domain = ""

# GitHub App (from github.com/organizations/<org>/settings/apps/<app>)
# github_app_id            = "2954599"
# github_app_name          = "traceroot-app"
# github_app_client_id     = "Iv23li..."
# github_app_client_secret = "e4f107..."
# github_app_private_key   = file("path/to/private-key.pem")

# LLM API Keys
# anthropic_api_key = "sk-ant-..."
# openai_api_key    = "sk-proj-..."
# daytona_api_key   = "dtn_..."

# Google OAuth
# google_oauth_client_id     = "123456.apps.googleusercontent.com"
# google_oauth_client_secret = "GOCSPX-..."

# Stripe Billing
# Note: Use test keys for staging, live keys for production
# stripe_secret_key              = "sk_test_..."
# stripe_webhook_signing_secret  = "whsec_..."
# stripe_price_id_starter        = "price_..."
# stripe_price_id_pro            = "price_..."
# stripe_price_id_ai_usage       = "price_..."
# stripe_price_id_rca_usage      = "price_..."   # metered: per-RCA-run
# stripe_price_id_detector_usage = "price_..."   # metered: managed detector inference (1.05x pass-through)

# Slack OAuth (workspace-level integration for detector alerts)
# In your Slack App settings, register redirect URL:
#   https://<your-domain>/api/slack/oauth/callback
# State secret is auto-generated by Terraform — no need to set it.
# slack_client_id     = "1234567890.0987654321"
# slack_client_secret = "..."

# Email / SMTP
# smtp_url       = "smtp://user:pass@host:587"
# smtp_mail_from = "noreply@traceroot.ai"

# Enterprise License
# enterprise_license_key = "traceroot_ee_..."


# Feature Flags
# enable_billing = "true"  # Set "false" for self-hosted to unlock all features
# enable_sql_gateway = false  # Provision the ClickHouse identities the public SQL gateway needs (requires chart >= 1.1.0)

# Replicas
# web_replicas    = 1
# rest_replicas   = 1
# worker_replicas = 1

# Worker pod CPU and memory (raise limits.memory if worker pods are OOMKilled)
# worker_resources = {
#   limits = { memory = "2Gi" }
# }

# Detector pod CPU and memory (raise memory if the detector crashes with "JavaScript heap out of memory";
# on Fargate, raise requests too, since Fargate sizes the pod from its requests)
# detector_resources = {
#   requests = { cpu = "1", memory = "3Gi" }
#   limits   = { cpu = "1", memory = "3Gi" }
# }

# Additional environment variables (escape hatch for anything not covered above)
# Each entry must have either `value` (plain text) or `valueFrom` (secret reference), not both.
# additional_env = [
#   { name = "CUSTOM_VAR", value = "custom-value" },
# ]
